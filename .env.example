# AI Governance Workshop configuration template.
# Copy this file to .env and fill in values, or let the notebooks prompt you
# and persist the answers here automatically. Never commit your real .env file.

# Azure subscription that contains the APIM instance (optional; az CLI default is used if blank)
AZURE_SUBSCRIPTION_ID=

# Resource group containing the existing APIM instance
APIM_RESOURCE_GROUP=

# Name of the existing APIM instance
APIM_NAME=

# Azure OpenAI backend used by Demo 1 (and later demos). AOAI_ENDPOINT must be
# the resource root with no path, e.g. https://<name>.services.ai.azure.com
# (Microsoft Foundry) or https://<name>.openai.azure.com (Azure OpenAI).
AOAI_ENDPOINT=
AOAI_DEPLOYMENT=

# Optional: Azure OpenAI API key, only used as a fallback when managed identity
# authentication from APIM to Azure OpenAI is not configured. Leave blank to
# prefer managed identity.
AOAI_KEY=

# Request surface to use: 'v1' for Microsoft Foundry
# (/openai/v1/chat/completions, deployment sent in the body as "model") or
# 'classic' for Azure OpenAI (/openai/deployments/<deployment>/chat/completions)
AOAI_API_STYLE=v1

# Optional: override the API version used for Azure OpenAI calls (classic style only)
AOAI_API_VERSION=2024-10-21

# Unique suffix baked into the Demo 1 token-limit counter key. Regenerating
# this value instantly resets the demo's rate/quota counters.
DEMO_RUN=
