# AI Governance Workshop configuration template.
# Copy this file to .env and fill in values, or let the notebooks prompt you
# and persist the answers here automatically. Never commit your real .env file.
#
# Format notes:
#   - Do NOT wrap values in quotes.
#   - Do NOT leave trailing spaces after a value.
#   - Values shown below are placeholders/examples only - replace them.

# ---------------------------------------------------------------------------
# Azure subscription + APIM (required)
# ---------------------------------------------------------------------------

# Azure subscription GUID that contains the APIM instance.
# Optional: if left blank, the az CLI default subscription is used.
# Find it with: az account show --query id -o tsv
# Example: 00000000-0000-0000-0000-000000000000
AZURE_SUBSCRIPTION_ID=

# Resource group containing the existing APIM instance.
# Find it with: az apim list --query "[].{name:name,rg:resourceGroup}" -o table
# Example: AIGovernanceOffering
APIM_RESOURCE_GROUP=

# Name of the existing APIM instance (not the gateway URL).
# Example: AIGovernanceOffering
APIM_NAME=

# ---------------------------------------------------------------------------
# Azure OpenAI / Microsoft Foundry backend (required for Demo 1 and later)
# ---------------------------------------------------------------------------

# AOAI_ENDPOINT must be the resource ROOT with no path and no trailing slash:
#   Microsoft Foundry: https://<your-resource>.services.ai.azure.com
#   Azure OpenAI:      https://<your-resource>.openai.azure.com
# Example: https://aigovernanceoffering.services.ai.azure.com
AOAI_ENDPOINT=

# The model DEPLOYMENT name you created in the portal (not the model name,
# though they often match).
# Example: gpt-4o
AOAI_DEPLOYMENT=

# Optional: Azure OpenAI API key, only used as a fallback when managed identity
# authentication from APIM to Azure OpenAI is not configured. Leave blank to
# prefer managed identity.
AOAI_KEY=

# Request surface to use: 'v1' for Microsoft Foundry
# (/openai/v1/chat/completions, deployment sent in the body as "model") or
# 'classic' for Azure OpenAI (/openai/deployments/<deployment>/chat/completions).
# Use 'v1' if your AOAI_ENDPOINT ends in .services.ai.azure.com
AOAI_API_STYLE=v1

# Optional: override the API version used for Azure OpenAI calls (classic style only)
AOAI_API_VERSION=2024-10-21

# ---------------------------------------------------------------------------
# Demo run identifier
# ---------------------------------------------------------------------------

# Unique suffix baked into the Demo 1 token-limit counter key. Regenerating
# this value instantly resets the Demo 1 rate/quota counters. Demo 2 also sends
# it as x-demo-run for request traceability, but does not use it as a metric
# dimension because ClientApp must remain bounded.
# Use a short lowercase hex string unique to you (8 chars works well):
#   python -c "import uuid; print(uuid.uuid4().hex[:8])"
# Example: a1b2c3d4
DEMO_RUN=

# ---------------------------------------------------------------------------
# Application Insights (optional, used by Demo 2)
# ---------------------------------------------------------------------------
# Application Insights resource used by the existing APIM instance for
# diagnostics and custom metrics verification. If APIM already has an
# Application Insights logger, Demo 2 can discover and reuse it. If not,
# provide either APP_INSIGHTS_RESOURCE_ID or APP_INSIGHTS_NAME plus the
# connection string so the notebook can create the APIM logger and API
# diagnostic.

# Short name of the Application Insights component.
# Example: ApimAppInsights
APP_INSIGHTS_NAME=

# Full ARM resource ID of the Application Insights component. Format:
# /subscriptions/<subscription-id>/resourceGroups/<rg>/providers/microsoft.insights/components/<name>
APP_INSIGHTS_RESOURCE_ID=

# Connection string from the Application Insights Overview blade. Keep it on a
# single line; it contains several semicolon-separated key=value pairs, e.g.:
# InstrumentationKey=<guid>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/;LiveEndpoint=https://<region>.livediagnostics.monitor.azure.com/;ApplicationId=<guid>
# Treat this as a secret - never commit the real value.
APP_INSIGHTS_CONNECTION_STRING=
