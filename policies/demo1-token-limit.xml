<policies>
  <inbound>
    <base />
    <!--
      Backend authentication: the Azure OpenAI / Microsoft Foundry resource has
      key authentication disabled, so APIM authenticates with its managed
      identity and forwards the resulting bearer token to the backend. Grant
      the APIM identity the 'Cognitive Services OpenAI User' role on the AI
      resource. (If an API key is supplied instead, the notebook swaps this
      block for an 'api-key' header sourced from the demo1-aoai-key named
      value.)
    -->
    <authentication-managed-identity resource="https://cognitiveservices.azure.com"
        output-token-variable-name="aoai-token" ignore-error="false" />
    <set-header name="Authorization" exists-action="override">
      <value>@("Bearer " + (string)context.Variables["aoai-token"])</value>
    </set-header>

    <!--
      Demo isolation: the counter-key combines the caller's APIM subscription id
      with the x-demo-run header value. Changing DEMO_RUN (and therefore the
      x-demo-run header sent by the notebook) instantly resets every counter
      below, with no need to wait for the TPM window or the daily window to roll.
    -->
    <azure-openai-token-limit
        counter-key='@(context.Subscription.Id + "-" + context.Request.Headers.GetValueOrDefault("x-demo-run","default"))'
        tokens-per-minute="{{demo1-tokens-per-minute}}"
        estimate-prompt-tokens="false"
        retry-after-header-name="Retry-After"
        tokens-consumed-header-name="tokens-consumed"
        remaining-tokens-header-name="remaining-tokens" />

    <!--
      Daily quota dimension: a separate counter (same demo-isolated key, but a
      distinct cache-key suffix and a 24h window) tracks cumulative tokens
      consumed for the day. Once the configured daily cap is exceeded we
      short-circuit the request with a 403 and a clear explanation, instead of
      relying on azure-openai-token-limit's own quota (which returns 429).
    -->
    <cache-lookup-value
        key='@("demo1-daily-" + context.Subscription.Id + "-" + context.Request.Headers.GetValueOrDefault("x-demo-run","default"))'
        variable-name="demo1DailyTokensUsed"
        default-value="0" />
    <choose>
      <when condition='@(int.Parse((string)context.Variables["demo1DailyTokensUsed"]) >= {{demo1-daily-token-cap}})'>
        <return-response>
          <set-status code="403" reason="Daily token budget exhausted" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>@{
            var used = (string)context.Variables["demo1DailyTokensUsed"];
            return new JObject(
              new JProperty("error", "daily_token_budget_exhausted"),
              new JProperty("message", "This demo's daily token budget has been exhausted. Change the x-demo-run header (DEMO_RUN) to reset instantly, or wait for the daily window to roll over."),
              new JProperty("dailyTokenCap", {{demo1-daily-token-cap}}),
              new JProperty("tokensUsedToday", used)
            ).ToString();
          }</set-body>
        </return-response>
      </when>
    </choose>
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
    <!--
      After a successful call, add this request's consumed tokens (reported by
      azure-openai-token-limit via the response header) to the daily counter,
      with a 24h sliding expiration.
    -->
    <set-variable name="demo1TokensConsumedThisCall"
        value='@{
            var header = context.Response.Headers.GetValueOrDefault("tokens-consumed", "0");
            int parsed;
            return int.TryParse(header, out parsed) ? parsed : 0;
        }' />
    <cache-lookup-value
        key='@("demo1-daily-" + context.Subscription.Id + "-" + context.Request.Headers.GetValueOrDefault("x-demo-run","default"))'
        variable-name="demo1DailyTokensUsedOutbound"
        default-value="0" />
    <cache-store-value
        key='@("demo1-daily-" + context.Subscription.Id + "-" + context.Request.Headers.GetValueOrDefault("x-demo-run","default"))'
        value='@(int.Parse((string)context.Variables["demo1DailyTokensUsedOutbound"]) + (int)context.Variables["demo1TokensConsumedThisCall"])'
        duration="86400" />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
